# Copy this file to `.env` and fill in your real values.
# NEVER commit your real .env file.

# --- LLM provider ---
# "anthropic" | "openai" | "fallback"
#
# Default: local freellmpool proxy (OpenAI-compatible). Install and run:
#   pip install freellmpool
#   freellmpool init --yes
#   freellmpool proxy          # http://localhost:8080 — leave this running
# Phin will also try to start the proxy itself if LLM_PROVIDER=openai and
# OPENAI_BASE_URL points at localhost.
LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# freellmpool / any OpenAI-compatible gateway. api_key is unused on loopback
# unless you set FREELLMPOOL_PROXY_KEY. model=auto lets the proxy pick.
OPENAI_API_KEY=unused
OPENAI_MODEL=auto
OPENAI_BASE_URL=http://localhost:8080/v1

# Used by LLM_PROVIDER=fallback, and by describe_screen (vision) even when
# the main provider is something else.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tried first when LLM_PROVIDER=fallback.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# --- Voice ---
ELEVENLABS_API_KEY=your_elevenlabs_key_here
# Rachel (premade) works on the free API tier. Voice Library IDs return 402.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Assistant identity ---
ASSISTANT_NAME=Phin
# openWakeWord pretrained model. There is no "Hey Phin" model yet —
# say "Hey Jarvis" to wake Phin. Drop a custom hey_phin.onnx later and
# change this to match.
WAKE_WORD_MODEL=hey_jarvis

# Microphone. Blank = OS default. Run `python main.py list-mics` first.
# MIC_DEVICE=3
# MIC_DEVICE=Realtek
MIC_DEVICE=

# --- File output ---
DESKTOP_PATH=C:\Users\YOUR_USERNAME\Desktop
